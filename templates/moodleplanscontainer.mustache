{{^element.frozen}}
    {{#js}}
        require(['jquery'], function($) {
            var container = $('.block_poodllclassroom_moodleplans_{{billinginterval}}');
            var toggleleftbutton = container.find('.toggle-left-button');
            var togglerightbutton = container.find('.toggle-right-button');
            var togglemaxbutton = container.find('.toggle-max-button');

            function updatePrices(themaxusers, $activeButton) {
                // Set active button state.
                container.find('.togglelink').removeClass('btn-primary active').addClass('btn-secondary');
                $activeButton.removeClass('btn-secondary').addClass('btn-primary active');

                // Filter prices and checkout buttons based on maxusers.
                container.find('.block_poodllclassroom_cbbuttons, .block_poodllclassroom_prices').each(function() {
                    if ($(this).attr('data-maxusers') == themaxusers) {
                        $(this).removeClass('block_poodllclassroom_hidden');
                    } else {
                        $(this).addClass('block_poodllclassroom_hidden');
                    }
                });
            }

            togglerightbutton.on('click', function() {
                updatePrices(600, $(this));
            });

            toggleleftbutton.on('click', function() {
                updatePrices(350, $(this));
            });

            togglemaxbutton.on('click', function() {
                updatePrices(1000, $(this));
            });
        });
    {{/js}}
{{/element.frozen}}
